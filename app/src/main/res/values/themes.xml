<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base para Material3, con soporte DayNight -->
    <style name="Theme.WheelsOnMotion" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores primarios -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>

        <!-- Fondo y texto -->
        <item name="android:windowBackground">@color/md_theme_background</item>
        <item name="android:textColor">@color/md_theme_onBackground</item>

        <!-- Fondo de superficies (cards, botones, etc.) -->
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>

        <!-- Barra de estado y navegación -->
        <item name="android:statusBarColor">@color/md_theme_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/md_theme_surface</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Elevaciones y sombras -->
        <item name="elevationOverlayEnabled">true</item>
    </style>

</resources>
